trap '' INT

export PATH=/usr/local/bin/middle_earth:$PATH
cols=$(tput cols)
if [ $cols -lt 150 ]
then
        echo "************************************************"
        echo "     Your console resolution is too low."
        echo "It needs at least 150 columns to work properly"
        echo "       You have ${cols}                       "
        echo "************************************************"
        exit 1
fi

# Check if container has been initialized by looking for running containers
check_initialized() {
    # Check if Prancing Pony container is running
    if docker ps --format "{{.Names}}" | grep -q "prancing_pony"; then
        return 0  # Container is running
    else
        return 1  # Container not running
    fi
}

# Check if any user exists
existent_user=$(find /home -mindepth 1 -maxdepth 1 -type d ! -name hobbiton ! -name dockremap | head -n1 |xargs -r basename )

# If container not initialized, show initialization
if ! check_initialized && [ -z "$existent_user" ]; then
    images=("nazgul" "hide_hobbits" "prancing_pony")
    containers=("nazgul0" "nazgul1" "nazgul2" "nazgul3" "nazgul4" "nazgul6" "nazgul7" "nazgul5" "prancing_pony")
    services=("process_users")
    bar_length=50
    total_images=${#images[@]}  
    total_containers=${#containers[@]} 
    total_services=${#services[@]}
    
    progress_bar() {
      local percent=$1
      printf "\r[%-${bar_length}s]" "$(printf "%0.s#" $(seq 1 $(( (percent * bar_length) / 100 ))))"
    }
    
    check_docker()
      for ((i=0; i<1; i++)); do
        while ! sudo docker info > /dev/null 2>&1; do
          sleep 1
        done
        progress=$(( ((i + 1) * 100) / 1))
        progress_bar $progress
      done
    
    #check_supervisor
    #check_mysql
    #check_process
    
    clear
    
    echo ""
    echo "                  LOADING GAME OBJECTS "
    echo ""
    echo ""
    echo "Checking docker is running...."
    
    echo ""
    check_docker
    echo ""
    echo "Docker is running fine"
    
    echo ""
    echo "-----------------------------------------------"
    echo ""
    echo "Checking required services are running"
    
    echo ""
    for ((i=0; i<$total_services; i++)); do
      while ! sudo supervisorctl status|grep "process_users"|grep "RUNNING" > /dev/null 2>&1; do
        sleep 1
      done
      progress=$(( ((i + 1) * 100) / total_services))
      progress_bar $progress
    done
    echo ""
    echo "All services are up and running"
    echo ""
    echo ""
    echo "-----------------------------------------------"
    echo ""
    echo "Detecting required images..."
    
    echo ""
    for ((i=0; i<$total_images; i++)); do
      while ! sudo docker images --format "{{.Repository}}" | grep -q "${images[$i]}"; do
        sleep 1
      done
      progress=$(( ((i + 1) * 100) / total_images ))
      progress_bar $progress
    done
    

    echo ""
    echo "All images have been detected"
    
    echo ""
    echo "-----------------------------------------------"
    echo ""
    echo "Checking containers are running"
    
    echo ""
    for ((i=0; i<$total_containers; i++)); do
      while ! sudo docker ps --format "{{.Names}}" | grep -q "${containers[$i]}"; do

        sleep 1
      done
      progress=$(( ((i + 1) * 100) / total_containers ))
      progress_bar $progress
    done
    echo ""
    echo "All containers are up and running"
    echo ""
    echo ""
    echo ""
    echo "Everything is ready for starting..."
    read -n 1 -r -s -p "Press any key to continue..." key
    clear
fi

# If a user exists, switch to them
if [ ! -z $existent_user ]; then
    # Check if it's a valid user (not hobbiton)
    if [ "$existent_user" != "hobbiton" ] && id "$existent_user" > /dev/null 2>&1; then
        sudo su - "$existent_user"
    fi
fi


# User creation workflow
is_valid_name() {
    local name="$1"
    [[ "$name" =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]]
}


pick_ansi() {
  local hq="$1"
  if [[ $LANG == *"UTF-8"* ]] || [[ $LC_ALL == *"UTF-8"* ]]; then
    echo "$hq"
  else
    local low="${hq%.*}_low.ansi"
    if [ -e "$low" ]; then
      echo "$low"
    else
      echo "$hq"
    fi
  fi
}

if [ -z $existent_user ]; then

  mkdir -p /tmp/middle_earth
  showlines $(pick_ansi /usr/local/bin/middle_earth/data/ring.ansi)
  read -n 1 -r -s -p "Press any key to continue..." key
  clear
  while true; do
      echo ""
      echo ""
      echo "Welcome to Hobbiton. "
      echo "For starting the game you should create a username"
      echo -n "Please, enter a unique name here: "
      read -r name
  
      if ! is_valid_name "$name"; then
          echo "Invalid name. It must start with a letter and only contain letters, numbers, '_' or '-'."
          continue
      fi
  
      if getent passwd "$name" >/dev/null; then
          echo "Name matches an existing system user. Try another."
          continue
      fi
  
      if [[ -e "/tmp/middle_earth/$name" ]]; then
          echo "Someone has already picked that name. Try another."
          continue
      fi
  
      touch "/tmp/middle_earth/$name"
      if [ $? -eq 0 ] 
      then
          IP=$(ip -4 -o addr show eth0 | awk '{print $4}' | cut -d'/' -f1)
          clear
          echo "************************************************************"
          echo "**      Wait while your user is being created...          **"
          echo "**                                                        **"
          echo "**            It could take some seconds for              **"
          echo "**             configuring you environment                **"
          echo "**                                                        **"
          echo "** Once it is ready, you will be automatically redirected **"
          echo "**                                                        **"
          echo "**                                                        **"
          echo "**                  IMPORTANT TIP:                        **"
          echo "**                                                        **"
          echo "**   In case you exit the game, you can resume it with    **"
          echo "**   docker exec -it -u <your_username> lotr /bin/bash    **"
          echo "**                                                        **"
          echo "**                                                        **"
          echo "************************************************************"
          echo ""
      fi
      echo "Testing file /tmp/middle_earth/$name exists"
      while [ -e /tmp/middle_earth/$name ]
      do
          sleep 1
      done
  
      # Final check to ensure home directory and .bashrc are ready
      for i in $(seq 1 5); do
          if [ -d "/home/$name" ] && [ -f "/home/$name/.bashrc" ]; then
              break
          fi
          sleep 1
      done
      
      echo ""
      break
  done
  
  sudo su - $name
fi
exit
