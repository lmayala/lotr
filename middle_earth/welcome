#!/bin/bash
trap '' 2
SRC=/usr/local/bin/middle_earth
DATA=$SRC/data
DBID=$(( `id -u` + 1000))
STAGE=""

# Retry mechanism for database read
for i in $(seq 1 10); do
    STAGE=`sqlite3 -separator " " /var/lib/middle_earth/middle_earth.db "SELECT stage_completed + 1 FROM stages WHERE user_id = $DBID" 2>/dev/null`
    
    # Check if we got a result
    if [ -n "$STAGE" ] && [ "$STAGE" != "NULL" ]; then
        break
    fi
    
    # Wait a bit before retrying
    sleep 1
done

# If after 10 retries we still don't have a value, exit with error
if [ -z "$STAGE" ] || [ "$STAGE" = "NULL" ] || [ "$STAGE" = "" ]; then
    echo "ERROR: Database not ready after 10 retries. Game may be broken." >&2
    exit 1
fi

function keypause () {

	read -n 1 -r -s -p "Press any key to continue..." key
}

if [ `tput cols` -lt 150 ]
then
	echo "************************************************"
	echo "     Your console resolution is too low."
	echo "It needs at least 150 columns to work properly"
	echo "************************************************"
	exit 1
fi

clear
if [ "$STAGE" == "1" ] 
then
   showlines $DATA/gandalf.ansi DELAY=0.04
   sleep 2
   toilet -ktf small --gay < $DATA/quote1.txt
   keypause
   clear
fi
if [ -e $DATA/story_${STAGE}.txt ]
then
    showlines $DATA/story_${STAGE}.txt
    keypause
fi
helpme
keypause
if [ "$STAGE" == "6" ]
then
    PROCESS=$(pgrep -u $USER sshd | head -1)
    if [ "$PROCESS" != "" ]
    then
        kill -9 $(pgrep -u $USER sshd | head -1)
    fi
    kill -9 $PPID
fi
echo ""
